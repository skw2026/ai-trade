{
  "schema_version": "market_alpha_development_policy_v1",
  "research_domain": "development_only",
  "promotion_evidence": false,
  "bar_contract": {
    "target_symbol": "SOLUSDT",
    "interval_ms": 300000,
    "timestamp_semantics": "bar_open_time",
    "usable_after": "bar_open_time+interval_ms",
    "execution_latency_bars": 1
  },
  "historical_sources": {
    "cross_market_cross_asset": {
      "provider": "Binance public data",
      "market": "futures_um",
