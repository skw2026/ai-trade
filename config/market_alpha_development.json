    "target_trade_flow": {
      "provider": "Bybit public trade archive",
      "symbol": "SOLUSDT",
      "sample_days_required": 1,
      "full_backfill_supported": true
    }
  },
  "forward_sources": {
    "provider": "Bybit public WebSocket v5",
    "topics": [
      "orderbook.50.SOLUSDT",
      "publicTrade.SOLUSDT",
      "orderbook.50.BTCUSDT",
      "publicTrade.BTCUSDT",
      "orderbook.50.ETHUSDT",
      "publicTrade.ETHUSDT"
    ],
    "cross_asset_alignment": "exact_exchange_second_inner_join_v1",
    "raw_capture_required": true,
    "deterministic_replay_required": true,
    "bucket_ms": 1000
  },
  "development_economic_gate": {
    "calibration": "nested_validation_quantile",
    "minimum_total_trades": 20,
    "minimum_positive_split_ratio": 0.5,
    "minimum_net_edge_lcb_bps": 0.0
  },
  "remaining_promotion_gates": [
    "independent_selection",
    "untouched_final_holdout",
    "offline_online_feature_parity",
    "demo_forward_profitability"
  ]
